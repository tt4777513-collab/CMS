# APP_NAME=CMS Pro
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=http://localhost

# DATABASE
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cms_pro
DB_USERNAME=root
DB_PASSWORD=

# MAIL
MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=465
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=admin@cms-pro.com
MAIL_FROM_NAME="CMS Pro"

# JWT
JWT_SECRET=your-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRATION=3600

# STORAGE
FILESYSTEM_DRIVER=local
APP_STORAGE_PATH=/storage/app
BACKUP_STORAGE_PATH=/storage/backups
MAX_UPLOAD_SIZE=10485760

# CACHE
CACHE_DRIVER=file
SESSION_DRIVER=file

# LOGGING
LOG_CHANNEL=stack
LOG_LEVEL=debug

# TIMEZONE
APP_TIMEZONE=UTC+03:00

# PAGINATION
PAGINATION_ITEMS_PER_PAGE=10

# SEO
ENABLE_SITEMAP=true
ENABLE_ROBOTS=true
ENABLE_SCHEMA_MARKUP=true

# BACKUP
AUTO_BACKUP_ENABLED=true
AUTO_BACKUP_HOUR=00
AUTO_BACKUP_RETENTION_DAYS=30

# SECURITY
ENABLE_TWO_FACTOR=false
SESSION_TIMEOUT=3600
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_TIME=900
